{
 "atlas_facts": {
  "perineum_interval": {
   "fact": "the perineum occupies, externally, the interval between the upper medial thighs and the lower buttocks, limited in front by the mons pubis; one skin, continuous with the neighbouring regions",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, p. 343"
  },
  "outlet_diamond": {
   "fact": "diamond-shaped outlet: pubic arch / inferior pubic ligament in front, tip of the coccyx behind, ischiopubic rami and ischial tuberosities anterolaterally, sacrotuberous ligaments posterolaterally; palpable landmarks pubic symphysis, ischial tuberosities, coccyx",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, pp. 343-344; Drake RL, Vogl AW, Mitchell AWM et al. Gray's Atlas of Anatomy, Churchill Livingstone / Elsevier (edition not in the owner's scan), p. 244"
  },
  "interischial_line": {
   "fact": "the transverse line joining the two ischial tuberosities passes just in front of the anus (urogenital triangle in front, anal triangle behind)",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, pp. 344-345"
  },
  "labia_majora": {
   "fact": "two thick skin folds (fat-filled) running down and back from the mons pubis, diminishing posteriorly; lateral surface convex; they meet in front (anterior commissure, continuous with the mons) and behind (posterior commissure) on either side of the median pudendal cleft, almost horizontal when erect",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, pp. 361-362"
  },
  "posterior_commissure": {
   "fact": "the labia majora unite about an inch in front of the anus (posterior commissure), which overlies the perineal body",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, p. 361; Drake RL, Vogl AW, Mitchell AWM et al. Gray's Atlas of Anatomy, Churchill Livingstone / Elsevier (edition not in the owner's scan), p. 243"
  },
  "gyn_perineum": {
   "fact": "the gynaecological perineum, between the posterior commissure and the anus, is about an inch long",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, p. 362"
  },
  "mons": {
   "fact": "the mons pubis is the soft elevation over the pubic symphysis produced by a pad of fat",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, p. 361"
  },
  "vestibule": {
   "fact": "labia minora, vestibule, urethral and vaginal openings lie within the pudendal cleft, medial to the labia majora",
   "cite": "Noor MA. Mannan's Regional Dissection and Surface Anatomy, 14th ed. Jaypee, New Delhi 2017, pp. 361-362; Drake RL, Vogl AW, Mitchell AWM et al. Gray's Atlas of Anatomy, Churchill Livingstone / Elsevier (edition not in the owner's scan), pp. 242-243"
  }
 },
